# Jira URL without a trailing slash
JIRA_BASE_URL=https://your-company.atlassian.net

# Jira Cloud normally uses version 3.
# Some Jira Data Center installations use version 2.
JIRA_API_VERSION=3

# Jira Cloud authentication
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Data Center personal access token
# Leave empty when using Jira Cloud.
JIRA_BEARER_TOKEN=

JIRA_VERIFY_SSL=true
JIRA_TIMEOUT_SECONDS=30

# BigQuery project where dry-run jobs are submitted.
BQ_BILLING_PROJECT=replace-with-approved-gcp-project

# Must match the location of the referenced BigQuery datasets.
BQ_LOCATION=US

# Maximum bytes a single validation query may scan (default: 10 GiB).
# Raise this if legitimate queries exceed the limit.
BQ_MAX_BYTES_DEFAULT=10737418240

# API key for the LLM. Leave empty when using Vertex — it authenticates with ADC
# (gcloud auth application-default login locally, the attached service account on
# Cloud Run), so no key exists to set.
LLM_API_KEY=

# Jira label the agent acts on. It marks a ticket as the agent's work — it does not
# select an environment; the project/dataset in the ticket decides what gets queried.
VALIDATION_LABEL=validation-agent

# Optional bulk-scan filters. Leave the board ID empty to scan by JQL only.
JIRA_BULK_JQL=labels = validation-agent
JIRA_BOARD_ID=

# Local dashboard server. Keep the host loopback-only unless you put it behind auth.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# --- Which model runs -----------------------------------------------------
# Changing model is a config change only. Both agents build one OpenAI client
# from these two variables; nothing else needs editing.
#
# Default is Gemini on Vertex via its OpenAI-compatible endpoint. The base URL is
# built from GOOGLE_CLOUD_PROJECT, so only these two are normally needed. Note the
# "google/" model prefix, and that 3.7-flash is served only from `global` — a
# regional location 404s rather than falling back.
LLM_MODEL=google/gemini-3.7-flash
GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=global
#
# Any other OpenAI-compatible provider: set the endpoint and key explicitly and
# the agents need no code change.
# LLM_BASE_URL=https://<provider>/v1
# LLM_API_KEY=<key>
